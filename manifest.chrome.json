{
  "manifest_version": 3,
  "default_locale": "id",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://sivitas.id/*", "https://*.sivitas.id/*", "http://localhost:4321/*"],
      "js": ["content/bridge-detector.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
